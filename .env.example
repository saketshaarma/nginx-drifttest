# ==== DriftWatch docker-compose environment ====
# Copy to .env in the same folder as docker-compose.yml and fill in the secrets.

# Database
DB_NAME=driftwatch

# Auth / crypto secrets:
#   JWT_SECRET     - any long random string works. Suggested:
#                    python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY - encrypts stored SSH passwords. Any string is accepted (a proper
#                    Fernet key is used as-is; anything else is turned into a valid key).
#                    For production, generate a real one:
#                    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                    Do NOT change it once data exists, or saved SSH passwords can't be decrypted.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-fernet-key

# Seeded admin login
ADMIN_EMAIL=admin@driftwatch.io
ADMIN_PASSWORD=admin123

# Public URL the browser uses to reach the frontend (used for CORS)
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Leave REACT_APP_BACKEND_URL empty for same-origin (nginx proxies /api -> backend).
# Only set it if you host the backend on a different domain.
REACT_APP_BACKEND_URL=

# Freshdesk — set your real subdomain + API key to create REAL tickets.
#   FRESHDESK_DOMAIN: just the host, e.g. acme.freshdesk.com (no https://)
#   FRESHDESK_API_KEY: from Freshdesk > Profile settings > Your API Key
#   FRESHDESK_REQUESTER_EMAIL: email used as the ticket requester (defaults to ADMIN_EMAIL)
# Leave DOMAIN=yourcompany.freshdesk.com or KEY=MOCK_KEY to stay in mock mode.
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=MOCK_KEY
FRESHDESK_REQUESTER_EMAIL=
