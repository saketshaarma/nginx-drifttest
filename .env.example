# ==== DriftWatch docker-compose environment ====
# Copy to .env in the same folder as docker-compose.yml and fill in the secrets.

# Database
DB_NAME=driftwatch

# Auth / crypto secrets — GENERATE YOUR OWN before deploying:
#   JWT_SECRET      ->  python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY  ->  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me-to-a-64-char-hex-secret
ENCRYPTION_KEY=change-me-to-a-fernet-key

# Seeded admin login
ADMIN_EMAIL=admin@driftwatch.io
ADMIN_PASSWORD=admin123

# Public URL the browser uses to reach the frontend (used for CORS)
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Leave REACT_APP_BACKEND_URL empty for same-origin (nginx proxies /api -> backend).
# Only set it if you host the backend on a different domain.
REACT_APP_BACKEND_URL=

# Freshdesk (currently MOCKED in-app; fill these when wiring the real API)
FRESHDESK_DOMAIN=demo.freshdesk.com
FRESHDESK_API_KEY=MOCK_KEY
